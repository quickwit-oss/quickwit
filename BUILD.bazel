load("@com_datadoghq_cnab_tools//rules:cli_defaults.bzl", "REGISTRY")
load("@com_datadoghq_cnab_tools//rules:workflow.bzl", "cnab_workflow", "cnab_installation")
load("@com_datadoghq_datacenter_config//rules:helm.bzl", "dd_helm_cnab", "dd_helm_cnab_installation")

dd_helm_cnab(
    name = "pomsky-cnab",
    chart = "@pomsky_helm_charts//charts/quickwit:chart",
    registry = REGISTRY,
    repository = "pomsky-cnab",
    tags = [
        "service:pomsky",
        "team:logs-cloudprem",
    ],
    visibility = ["//visibility:public"],
    with_datacenter_helm_files = False,
)

default_params = {
    "manualJudgementSlackChannel": "release-ops",
}

dd_helm_cnab_installation(
    name = "pomsky.logs-cloudprem.vaporeon-b.us1.staging.dog",
    bundle = ":pomsky-cnab",
    description = "Pomsky Staging",
    parameters = default_params,
    value_files = [],
)

cnab_workflow(
    name = "pomsky-workflow",
    description = "Deploy Pomsky to staging",
    parallel = True,
    tasks = [
        ":pomsky.logs-cloudprem.vaporeon-b.us1.staging.dog",
    ],
    tags = [
        "env:staging",
        "service:pomsky",
        "team:logs-cloudprem",
    ],
    visibility = ["//visibility:public"],
)
